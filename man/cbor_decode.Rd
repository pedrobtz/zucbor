\section{CBOR to R}{
\tabular{ll}{
   CBOR \tab R \cr
   integer \tab \code{integer} if it fits, else \code{double} up to 2^53, else by \code{big_integers} \cr
   float (half, single, double) \tab \code{double}, exactly \cr
   \code{false} / \code{true} \tab \code{logical} \cr
   \code{null}, \code{undefined} \tab \code{NULL}, or \code{NA} inside an atomic vector \cr
   byte string \tab \code{raw} \cr
   text string \tab \code{character}, UTF-8 \cr
   other simple value \tab \code{cbor_simple} \cr
   array \tab atomic vector when the elements agree, else \code{list} \cr
   map with non-empty, unique text keys \tab named \code{list} \cr
   any other map \tab \code{cbor_map} (by \code{map_keys}) \cr
   tag 0 (date/time text), tag 1 (epoch) \tab \code{POSIXct}, UTC \cr
   tag 2, 3 (bignum) \tab the integer it holds, as for an integer; payloads over 128 bytes stay \code{cbor_tag} \cr
