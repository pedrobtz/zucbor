#!/bin/sh
# libFuzzer over the R-free check phase (roadmap Stage 7). Usage, from the
# package root:
#
#   tools/run-fuzz [seconds]        default 60 per target
#
# The canary (fuzz/fuzz_canary.c) must crash first, through the same code
# and flags, or the gate is not trusted: zuxml's fuzz gate once passed every
# run because it tested a pipe's exit status (zuxml #35). The grown corpus is
# kept in $FUZZ_CORPUS (default fuzz/corpus), which CI caches between runs so
# that fuzzing time accumulates. Needs a clang with libFuzzer (Apple's has
# none: tools/run-fuzz exits 2 there) and Rscript for the seeds.
set -eu

SECS=${1:-60}
CC=${FUZZ_CC:-clang}
CORPUS=${FUZZ_CORPUS:-fuzz/corpus}
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

printf 'int LLVMFuzzerTestOneInput(const unsigned char *d, unsigned long n) { (void) d; (void) n; return 0; }\n' > "$WORK/probe.c"
if ! $CC -fsanitize=fuzzer "$WORK/probe.c" -o "$WORK/probe" 2>/dev/null; then
  echo "run-fuzz: $CC has no libFuzzer runtime; set FUZZ_CC to one that does" >&2
  exit 2
fi

SRCS="src/zu_walk.c src/zu_status.c src/zu_float.c fuzz/arena.c
      src/vendor/tinycbor/cborparser.c src/vendor/tinycbor/cborvalidation.c
      src/vendor/tinycbor/cborerrorstrings.c"
FLAGS="-std=gnu17 -g -O1 -fno-omit-frame-pointer -fsanitize=fuzzer,address,undefined
       -fno-sanitize-recover=undefined -UNDEBUG -DZU_STANDALONE
       -Isrc -Isrc/tinycbor -Isrc/vendor/tinycbor"
for t in fuzz_canary fuzz_check; do
  $CC $FLAGS "fuzz/$t.c" $SRCS -o "$WORK/$t"
done

Rscript tools/fuzz-seeds.R "$WORK/seeds" > /dev/null
mkdir -p "$CORPUS" "$WORK/artifacts"

# 1. The canary must crash.
if "$WORK/fuzz_canary" -runs=100000 -artifact_prefix="$WORK/canary-" "$WORK/seeds" > "$WORK/canary.log" 2>&1; then
  echo "FAIL: the canary did not crash; the fuzz gate cannot be trusted" >&2
  exit 2
fi
ls "$WORK"/canary-* > /dev/null 2>&1 || { echo "FAIL: the canary exited without a crash artifact" >&2; exit 2; }
echo "==> canary crashed, as it must"

# 2. The target, for SECS seconds, over the cached corpus and the seeds.
status=0
"$WORK/fuzz_check" -max_total_time="$SECS" -max_len=65536 -dict=fuzz/cbor.dict \
  -artifact_prefix="$WORK/artifacts/" "$CORPUS" "$WORK/seeds" > "$WORK/fuzz.log" 2>&1 || status=$?
tail -5 "$WORK/fuzz.log"
if [ "$status" != 0 ] || [ -n "$(ls -A "$WORK/artifacts")" ]; then
  echo "FAIL: fuzz_check found a crash (exit $status):" >&2
  ls "$WORK/artifacts" >&2
  mkdir -p fuzz/artifacts && cp "$WORK/artifacts"/* fuzz/artifacts/ 2>/dev/null || true
  exit 1
fi
echo "==> fuzz_check: ${SECS}s, no finding; corpus now $(ls "$CORPUS" | wc -l | tr -d ' ') inputs"
