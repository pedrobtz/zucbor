#!/usr/bin/env Rscript
# Regenerate the conformance fixtures in tests/testthat/fixtures/ from their
# pinned upstream sources (roadmap Stage 6). Usage, from the package root:
#
#   tools/update-fixtures [output-dir]      default: tests/testthat/fixtures
#
# Tests read only the committed files and never touch the network.
# tools/run-conformance regenerates into a temporary directory and fails if
# the result differs from what is committed, so a fixture cannot drift from
# its source unnoticed. Needs jsonlite and network access.
#
# Sources, each pinned (an RFC's text is fixed once published):
QCBOR_COMMIT <- "65fd7cb41644477306761ed0f8514e17c66ccfa9"
COSE_COMMIT <- "53c9d634333bb4f529d78f5980fffa2667ee2c12"
WEBAUTHN_COMMIT <- "9d88b7681b10926a41fd18b78e206a01804ed855"

args <- commandArgs(trailingOnly = TRUE)
out <- if (length(args)) args[[1]] else file.path("tests", "testthat", "fixtures")
dir.create(out, showWarnings = FALSE, recursive = TRUE)

fetch <- function(url) {
  tmp <- tempfile()
  on.exit(unlink(tmp))
  utils::download.file(url, tmp, quiet = TRUE, mode = "wb")
  readLines(tmp, warn = FALSE, encoding = "UTF-8")
}

hex_of <- function(bytes) paste(sprintf("%02x", bytes), collapse = " ")
`%||%` <- function(a, b) if (is.null(a)) b else a

# ---- QCBOR: every not-well-formed vector ---------------------------------------
qcbor <- fetch(sprintf(
  "https://raw.githubusercontent.com/laurencelundblade/QCBOR/%s/test/not_well_formed_cbor.h",
  QCBOR_COMMIT))
src <- paste(qcbor, collapse = "\n")
body <- sub("^.*paNotWellFormedCBOR\\[\\] = \\{", "", src)
body <- sub("\\};.*$", "", body)
m <- regmatches(body, gregexpr("\\{\\(uint8_t\\[\\]\\)\\{[^}]*\\},\\s*[0-9]+\\}", body))[[1]]
vectors <- vapply(m, function(v) {
  bytes <- strtoi(regmatches(v, gregexpr("(?<=0x)[0-9a-fA-F]{2}", v, perl = TRUE))[[1]], 16L)
  n <- as.integer(sub(".*\\},\\s*([0-9]+)\\}$", "\\1", v))
  # Three entries declare a length that differs from their bytes. Where it
  # is shorter, QCBOR's test reads only that many, so do we; where it is
  # longer, the test reads past its own array, and the bytes listed are
  # what is really there.
  if (n < length(bytes)) bytes <- bytes[seq_len(n)]
  hex_of(bytes)
}, "", USE.NAMES = FALSE)
stopifnot(length(vectors) == 122L, !anyDuplicated(vectors))
writeLines(c(
  "# QCBOR test/not_well_formed_cbor.h, every vector, one per line as hex.",
  sprintf("# https://github.com/laurencelundblade/QCBOR at %s", QCBOR_COMMIT),
  "# Copyright (c) 2019, Laurence Lundblade. All rights reserved.",
  "# BSD-3-Clause; the licence text is in QCBOR-LICENSE beside this file.",
  "# Generated by tools/update-fixtures; do not hand-edit.",
  vectors), file.path(out, "qcbor-not-well-formed.txt"))

# ---- cose-wg/Examples: every message and every signed or MACed structure -------
zip <- tempfile(fileext = ".tar.gz")
utils::download.file(sprintf("https://github.com/cose-wg/Examples/archive/%s.tar.gz", COSE_COMMIT),
                     zip, quiet = TRUE, mode = "wb")
dir <- tempfile()
utils::untar(zip, exdir = dir)
root <- list.dirs(dir, recursive = FALSE)[[1]]
files <- sort(list.files(root, "\\.json$", recursive = TRUE))
rows <- list()
add <- function(kind, file, hex, diag = "") {
  rows[[length(rows) + 1L]] <<- c(kind, file, tolower(hex), gsub("\\s+", " ", trimws(diag)))
}
walk <- function(x, file) {
  if (is.list(x)) {
    nm <- names(x)
    for (i in seq_along(x)) {
      k <- if (is.null(nm)) "" else nm[[i]]
      if (k %in% c("ToBeSign_hex", "ToMac_hex", "AAD_hex") && is.character(x[[i]])) add(k, file, x[[i]])
      else walk(x[[i]], file)
    }
  }
}
for (f in files) {
  j <- jsonlite::fromJSON(file.path(root, f), simplifyVector = FALSE)
  add("output", f, j$output$cbor, j$output$cbor_diag %||% "")
  walk(j$intermediates, f)
}
tab <- do.call(rbind, rows)
colnames(tab) <- c("kind", "file", "hex", "diag")
stopifnot(sum(tab[, "kind"] == "output") == 306L)
utils::write.table(tab, file.path(out, "cose-wg-examples.tsv"), sep = "\t", quote = FALSE,
                   row.names = FALSE)

# ---- Specification examples: RFC 8392 (CWT), RFC 8428 (SenML), WebAuthn L3 ------
rfc_figures <- function(lines, pattern) {
  res <- list()
  for (i in grep("^\\s+Figure [0-9]+: ", lines)) {
    title <- trimws(sub("^\\s+Figure [0-9]+: ", "", lines[[i]]))
    if (!grepl(pattern, title)) next
    j <- i - 1L
    while (j > 0L && !nzchar(trimws(lines[[j]]))) j <- j - 1L
    block <- character()
    while (j > 0L && grepl("^\\s+[0-9a-fA-F]+$", lines[[j]])) {
      block <- c(trimws(lines[[j]]), block)
      j <- j - 1L
    }
    if (length(block)) res[[length(res) + 1L]] <- c("RFC 8392", title, tolower(paste(block, collapse = "")))
  }
  res
}
spec <- rfc_figures(fetch("https://www.rfc-editor.org/rfc/rfc8392.txt"), "[Hh]ex")
stopifnot(length(spec) == 9L)

senml <- fetch("https://www.rfc-editor.org/rfc/rfc8428.txt")
at <- grep("dump of the CBOR example for the same", senml, fixed = TRUE)
dump <- regmatches(senml[at:(at + 40L)], regexpr("^ [0-9a-f]{4} ((?:[0-9a-f]{2} )+)", senml[at:(at + 40L)], perl = TRUE))
hex <- gsub(" ", "", sub("^ [0-9a-f]{4} ", "", dump))
spec[[length(spec) + 1L]] <- c("RFC 8428", "SenML CBOR example (Section 6)", paste(hex, collapse = ""))

bs <- fetch(sprintf("https://raw.githubusercontent.com/w3c/webauthn/%s/index.bs", WEBAUTHN_COMMIT))
heading <- ""
for (l in bs[grep("^# Test Vectors #", bs):length(bs)]) {
  if (grepl("^#+ ", l)) heading <- trimws(sub("\\s*#.*$", "", sub("^#+ ", "", l)))
  if (grepl("^attestationObject = h'", l)) {
    spec[[length(spec) + 1L]] <- c("WebAuthn L3", heading, sub("^attestationObject = h'([0-9a-f]+)'.*$", "\\1", l))
  }
}
spec <- do.call(rbind, spec)
colnames(spec) <- c("source", "label", "hex")
stopifnot(sum(spec[, "source"] == "WebAuthn L3") == 15L)
utils::write.table(spec, file.path(out, "spec-examples.tsv"), sep = "\t", quote = FALSE, row.names = FALSE)

cat("fixtures written to", out, "\n")
